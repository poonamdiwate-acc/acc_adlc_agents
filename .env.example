GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=C:/Reliance_Jio/acc_adlc_agents/vertex-sa.json
GOOGLE_GENAI_USE_VERTEXAI=true

# Required — ADLC service auth + audit repo
ADLC_API_KEY=replace-me-bearer-token-genwiz-uses
