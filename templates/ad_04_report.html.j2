<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>{{ agent_id }} — Gap Detection Report ({{ run_id }})</title>
    <style>
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            max-width: 1100px;
            margin: 0 auto;
            padding: 2rem;
            color: #1a1a1a;
            line-height: 1.6;
        }
        h1 { color: #1a365d; border-bottom: 3px solid #2b6cb0; padding-bottom: 0.5rem; }
        h2 { color: #2d3748; margin-top: 2rem; }
        .meta { color: #718096; font-size: 0.9rem; margin-bottom: 2rem; }
        .summary-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 1rem;
            margin: 1.5rem 0;
        }
        .summary-card {
            background: #f7fafc;
            border: 1px solid #e2e8f0;
            border-radius: 8px;
            padding: 1rem;
            text-align: center;
        }
        .summary-card .value {
            font-size: 2rem;
            font-weight: 700;
            color: #2b6cb0;
        }
        .summary-card .label { font-size: 0.85rem; color: #718096; }
        .quality-clean { color: #38a169; }
        .quality-needs_attention { color: #d69e2e; }
        .quality-blocked { color: #e53e3e; }
        .severity-critical { background: #fed7d7; color: #c53030; }
        .severity-high { background: #feebc8; color: #c05621; }
        .severity-medium { background: #fefcbf; color: #975a16; }
        .severity-low { background: #c6f6d5; color: #276749; }
        table {
            width: 100%;
            border-collapse: collapse;
            margin: 1rem 0;
            font-size: 0.9rem;
        }
        th, td {
            border: 1px solid #e2e8f0;
            padding: 0.6rem 0.8rem;
            text-align: left;
        }
        th { background: #edf2f7; font-weight: 600; }
        tr:nth-child(even) { background: #f7fafc; }
        .badge {
            display: inline-block;
            padding: 0.2rem 0.6rem;
            border-radius: 4px;
            font-size: 0.8rem;
            font-weight: 600;
        }
        .empty-state {
            text-align: center;
            padding: 3rem;
            color: #38a169;
            font-size: 1.2rem;
        }
    </style>
</head>
<body>
    <h1>{{ agent_id }} — Gap Detection Report</h1>
    <div class="meta">Run ID: {{ run_id }}</div>

    {% if gap_summary %}
    <h2>Summary</h2>
    <div class="summary-grid">
        <div class="summary-card">
            <div class="value">{{ gap_summary.total_requirements_analysed | default(0) }}</div>
            <div class="label">Requirements Analysed</div>
        </div>
        <div class="summary-card">
            <div class="value">{{ gap_summary.total_gaps_found | default(0) }}</div>
            <div class="label">Gaps Found</div>
        </div>
        <div class="summary-card">
            <div class="value">{{ gap_summary.blocking_gaps | default(0) }}</div>
            <div class="label">Blocking Gaps</div>
        </div>
        <div class="summary-card">
            <div class="value quality-{{ gap_summary.overall_quality | default('clean') }}">
                {{ gap_summary.overall_quality | default('N/A') }}
            </div>
            <div class="label">Overall Quality</div>
        </div>
    </div>

    {% if gap_summary.gaps_by_severity %}
    <h3>By Severity</h3>
    <table>
        <tr>
            {% for sev, count in gap_summary.gaps_by_severity.items() %}
            <th>{{ sev | capitalize }}</th>
            {% endfor %}
        </tr>
        <tr>
            {% for sev, count in gap_summary.gaps_by_severity.items() %}
            <td><span class="badge severity-{{ sev }}">{{ count }}</span></td>
            {% endfor %}
        </tr>
    </table>
    {% endif %}

    <p><strong>Recommendation:</strong> {{ gap_summary.recommendation | default('N/A') }}</p>
    {% endif %}

    <h2>Gap Report</h2>
    {% if gap_report %}
    <table>
        <thead>
            <tr>
                <th>Gap ID</th>
                <th>Req Ref</th>
                <th>Type</th>
                <th>Severity</th>
                <th>Description</th>
                <th>Recommendation</th>
            </tr>
        </thead>
        <tbody>
            {% for gap in gap_report %}
            <tr>
                <td>{{ gap.gap_id }}</td>
                <td>{{ gap.req_id_ref or 'N/A' }}</td>
                <td>{{ gap.gap_type }}</td>
                <td><span class="badge severity-{{ gap.severity }}">{{ gap.severity }}</span></td>
                <td>{{ gap.description }}</td>
                <td>{{ gap.recommendation }}</td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
    {% else %}
    <div class="empty-state">
        ✓ No gaps detected — requirements are clean.
    </div>
    {% endif %}
</body>
</html>
